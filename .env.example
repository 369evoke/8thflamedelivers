# ─── 8th Flame Delivery — environment variables ───
# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.
# Variables starting with NEXT_PUBLIC_ are sent to the browser. NEVER put secret keys in a NEXT_PUBLIC_ variable.

# Public site URL (used in emails, Stripe redirects, auth links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SECRET — server only

# Stripe — Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...         # SECRET
STRIPE_WEBHOOK_SECRET=whsec_...       # SECRET — from the webhook endpoint you create

# Email (Resend) — resend.com → API Keys. Verify your sending domain first.
RESEND_API_KEY=                       # SECRET
EMAIL_FROM="8th Flame Delivery <no-reply@yourdomain.ca>"
OPERATIONS_EMAIL=ops@yourdomain.ca    # receives staff alerts (new shipments, applications, exceptions)

# Google Maps Platform
GOOGLE_MAPS_SERVER_KEY=               # SECRET — Distance Matrix + Geocoding APIs, restrict by API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=      # Browser key — Maps JavaScript API, restrict by HTTP referrer
